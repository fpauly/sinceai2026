#!/bin/sh
# Runs before every `git push`. Blocks the push if typecheck, lint or build fail.
# Do not bypass with --no-verify (see CONTRIBUTING.md).
echo "pre-push: running npm run check ..."
npm run check --silent || {
  echo ""
  echo "pre-push: checks failed, push blocked. Fix the errors above and push again."
  exit 1
}
