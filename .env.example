# Copy to .env.local (never commit it):   cp .env.example .env.local
# Then fill in the values your lane needs. Restart `npm run dev` after changes.
#
#   Lane C / D: only the MongoDB section (+ DEMO_*). AI/voice work without keys (fallbacks).
#   Lane A:     MongoDB + Gemini
#   Lane B:     MongoDB + Gemini + Yext (+ ElevenLabs for the voice extra)

# Your lane: A | B | C | D  (npm run setup fills this in; the AI reads it)
AJANTASA_LANE=

# ---------- MongoDB (everyone) ----------
# Option 1: shared Atlas cluster. Lane B posts the URI in the team chat (never in git).
# Option 2: local Docker:  docker run -d --name ajantasa-mongo -p 27017:27017 mongo:7
MONGODB_URI=mongodb://localhost:27017
# Use YOUR OWN database name, so /api/seed doesn't wipe a teammate's data:
# ajantasa_a | ajantasa_b | ajantasa_c | ajantasa_d   (ajantasa_demo = the demo DB, lane B only)
MONGODB_DB=ajantasa_X

# ---------- Gemini (lane A, B) ----------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id from the current Gemini docs (a fast "flash" model). Lane A posts the chosen id in chat.
GEMINI_MODEL=

# ---------- Yext sandbox (lane B; details TBD from Fonecta) ----------
# Without a key, Apply still saves to MongoDB and the UI says Yext was not reached.
YEXT_API_KEY=
YEXT_ACCOUNT_ID=
YEXT_API_BASE=

# ---------- ElevenLabs (lane B, extra) ----------
# Key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# A voice that handles Finnish/English well (lane B picks it).
ELEVENLABS_VOICE_ID=

# ---------- Demo (everyone, keep as is) ----------
# "today" for the detection rules, so the demo is deterministic
DEMO_DATE=2026-12-10
# en | fi
DEMO_LANGUAGE=en
